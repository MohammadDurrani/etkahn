---
import Mark from './Mark.astro';
import Arrow from './Arrow.astro';
import { email, navigation } from '../data/site';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-main">
      <div>
        <a href="/" class="brand" aria-label="Etkahn home"><Mark />Etkahn<span>.</span></a>
        <p>We shape software around the way you work.</p>
      </div>
      <nav aria-label="Footer navigation">
        <div>{navigation.slice(1).map(({ href, label }) => <a href={href}>{label}</a>)}</div>
      </nav>
      <div class="footer-contact">
        <a href={`mailto:${email}`} class="text-link">{email} <Arrow /></a>
      </div>
    </div>
    <div class="footer-base micro"><span>© {new Date().getFullYear()} Etkahn</span><span>Independent technology studio <b>·</b> Pakistan</span></div>
  </div>
</footer>
