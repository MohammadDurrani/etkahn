---
import Site from '../layouts/Site.astro';
import Arrow from '../components/Arrow.astro';
import Mark from '../components/Mark.astro';
import Closing from '../components/Closing.astro';
import { process } from '../data/site';

const values = [
  { title: 'Solve the right problem.', detail: 'We look at the work, the people doing it, and what’s getting in their way before we recommend a solution.' },
  { title: 'Keep things understandable.', detail: 'We explain our recommendations in plain language, including what they cost and what tradeoffs they involve.' },
  { title: 'Build to last.', detail: 'We consider how the system will perform, stay secure, and be maintained as your needs change.' },
  { title: 'Respect your independence.', detail: 'We give you the documentation and access you need to run the work or take it to another developer.' },
  { title: 'Take responsibility.', detail: 'We share progress, flag limitations early, and take care with the systems and information you entrust to us.' },
];
---
<Site title="About — Etkahn" description="Meet Etkahn, an independent software and technology studio in Pakistan. Learn how we scope, build, test, and hand over our work.">
  <section class="wrap about-hero">
    <h1>Technology should make <em>work easier.</em></h1>
    <p class="lead">Working with the people who build it should be just as straightforward.</p>
  </section>

  <section class="section values-band">
    <div class="wrap editorial-split">
      <h2>Standards we<br /><em>work by.</em></h2>
      <ul class="values-list" role="list">
        {values.map(({ title, detail }) => <li><h3>{title}</h3><p>{detail}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section wrap editorial-split process-section">
    <div class="section-intro"><h2>From first call<br /> <em>to handover.</em></h2><p class="lead">At each stage, you know what we’re working on, what decisions are open, and what happens next.</p></div>
    <ol class="timeline" role="list">
      {process.map(({ title, detail }) => <li><h3>{title}</h3><p>{detail}</p></li>)}
    </ol>
  </section>

  <section class="section studio-band">
    <div class="wrap studio-layout">
      <div class="studio-symbol" aria-hidden="true"><span class="micro">ETK / STUDIO</span><Mark /><span class="micro">PK / INDEPENDENT</span></div>
      <div><h2>Independent.<br /><em>Based in Pakistan.</em></h2><p class="lead">Etkahn is a software and technology studio. We work with businesses, founders, and individuals who need careful engineering and clear communication, whether the job is a small repair or a new system.</p><a href="/work" class="text-link">See our work <Arrow /></a></div>
    </div>
  </section>
  <Closing title="Let’s talk about" accent="what you need." description="Share what you’re trying to achieve and what’s getting in the way." label="Get a quote" />
</Site>
