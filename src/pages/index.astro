---
import Site from '../layouts/Site.astro';
import Arrow from '../components/Arrow.astro';
import Closing from '../components/Closing.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import SystemDiagram from '../components/SystemDiagram.astro';
import { projects } from '../data/projects';
import { services } from '../data/site';

const approach = [
  { title: 'Understand', text: 'We look at how the work happens today and agree on the problem worth solving.' },
  { title: 'Build', text: 'We agree on scope, build in clear stages, and share progress as decisions are made.' },
  { title: 'Improve', text: 'We test, document, and hand over the work. We can help maintain it as your needs change.' },
];
---
<Site title="Etkahn — Independent Software & Technology Studio" description="Etkahn builds websites and custom software, connects systems, and repairs existing technology. An independent studio based in Pakistan.">
  <section class="home-hero wrap">
    <div class="hero-copy">
      <h1>Technology that <em>fits the way you work.</em></h1>
      <p class="lead">We build websites and software, improve the systems you rely on, and connect the tools that keep your work moving.</p>
      <div class="hero-actions">
        <a class="button" href="/contact">Get a quote <Arrow /></a>
        <a class="text-link" href="/work">Explore our work <Arrow diagonal={false} /></a>
      </div>
    </div>
    <SystemDiagram />
  </section>

  <section class="section wrap editorial-split">
    <div class="section-intro">
      <h2>What we <em>do.</em></h2>
      <p class="lead">From a new website to a stubborn technical problem, we find the approach that fits the work.</p>
      <a href="/services" class="text-link">Explore our services <Arrow /></a>
    </div>
    <ul class="service-index" role="list">
      {services.map((service) => (
        <li>
          <a href={`/services#${service.id}`}>
            <div><h3>{service.title}</h3><p>{service.summary}</p></div>
            <Arrow />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section work-band">
    <div class="wrap">
      <div class="section-head">
        <h2>Selected <em>work.</em></h2>
        <a href="/work" class="text-link">View all work <Arrow /></a>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-card">
            <a href={`/work#${project.id}`} aria-label={`View ${project.name}`}>
              <ProjectMedia project={project} preview />
              <div class="project-meta"><h3>{project.name}</h3><Arrow /></div>
              <p>{project.summary}</p>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>How we <em>work.</em></h2>
      <a href="/about" class="text-link">Get to know the studio <Arrow /></a>
    </div>
    <ol class="approach-grid" role="list">
      {approach.map((step) => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}
    </ol>
  </section>

  <Closing title="Have a problem" accent="worth solving?" description="Tell us where things are getting stuck or what you want to build." />
</Site>
